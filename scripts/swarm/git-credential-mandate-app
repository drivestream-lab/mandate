#!/usr/bin/env bash
# git credential helper: hands git a fresh App installation token for one swarm role.
#
# Configured per command (never in a shared .git/config), for example:
#   git -c credential.helper= \
#       -c "credential.helper=!$PWD/scripts/swarm/git-credential-mandate-app builder" push
# scripts/swarm/as_role.sh does this for you.
#
# Only `get` for github.com answers; `store` and `erase` are ignored, so the token is
# never kept by another helper.
set -euo pipefail

role="${1:-}"
op="${2:-}"
[[ "$op" == "get" ]] || exit 0

host=""
while IFS= read -r line && [[ -n "$line" ]]; do
  case "$line" in
    host=*) host="${line#host=}" ;;
  esac
done
[[ "$host" == "github.com" ]] || exit 0

token="$("$(dirname "$0")/app_token.sh" "$role")"
printf 'username=x-access-token\npassword=%s\n' "$token"
